# このファイルをコピーして .env を作成し、値を設定してください。
# cp .env.example .env
#
# .env はアプリが自動読み込みするものではありません。
# 実行時にシェルや systemd などから環境変数として渡してください。
# 例:
#   set -a && source .env && set +a && node main.js
#   (systemd の場合は EnvironmentFile=/path/to/.env を利用)

# ===== 必須 =====

# Google Home のIPアドレス
GOOGLE_HOME_IP=

# ngrok の authtoken
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ===== 任意 =====
# 未設定の場合、右のデフォルト値が使われます。

# サーバーのポート番号 (デフォルト: 8091)
#SERVER_PORT=8091

# Text-to-Speech の言語コード (デフォルト: ja-JP)
# https://cloud.google.com/text-to-speech/docs/voices
#TTS_LANGUAGE=ja-JP

# Text-to-Speech の音声名 (デフォルト: ja-JP-Standard-A)
# https://cloud.google.com/text-to-speech/docs/voices
#TTS_VOICE=ja-JP-Standard-A

# 生成したMP3を配信するエンドポイントのパス (デフォルト: /text-mp3)
#MP3_URL_PATH=/text-mp3

# 通知を受け付けるエンドポイントのパス (デフォルト: /google-home-notifier)
#NOTIFY_URL_PATH=/google-home-notifier

# 生成したMP3の出力先パス (デフォルト: sample.mp3)
#MP3_OUTPUT_PATH=sample.mp3

# ===== Google Cloud Text-to-Speech の認証 =====
# サービスアカウントJSONを使う場合は、Google Cloud標準の環境変数
# GOOGLE_APPLICATION_CREDENTIALS にJSONファイルのパスを設定してください。
# (gcloud CLI で Application Default Credentials を設定済みの場合は不要です)
# https://cloud.google.com/docs/authentication/application-default-credentials
#GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
